---
interface Props {
  id?: string;
  variant?: 'navy' | 'deep';
}
const { id, variant = 'deep' } = Astro.props;
const bg = variant === 'deep' ? 'bg-navy-deep' : 'bg-navy';

// Real production verification form destination (CallTrackingMetrics
// FormReactor). The key is a per-form public key (CTM's own submission
// model), not an account secret — safe to ship client-side.
const ctmEndpoint =
  'https://api.calltrackingmetrics.com/api/v1/formreactor/FRT472ABB2C5B9B141A2DBE35A5E3D5774F2FDF8F4847119AE399D078DDC41E2EC6';
const ctmKey = 'gTO5ApqgREYe8JMwXcWJfuuYSdh30HA81GbU6KHWA2JTkKAQ';
const nameFieldKey = 'field_126810542';
const emailFieldKey = 'field_113545921';
const phoneHref = 'tel:8886482661';
---
<div id={id} class:list={[bg, 'rounded-2xl p-6 md:p-8 scroll-mt-24']}>
  <h3 class="text-white text-center font-display font-bold text-xl md:text-2xl mb-5">
    Get Instant Insurance Verification
  </h3>
  <form class="space-y-4" data-insurance-form>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <label class="block">
        <span class="text-white text-field-label font-medium">Your Name<span class="text-coral">*</span></span>
        <input type="text" name="caller_name" required class="field mt-1 rounded-md border border-white/40 bg-white text-ink focus:outline-none focus:ring-2 focus:ring-teal" />
      </label>
      <label class="block">
        <span class="text-white text-field-label font-medium">Your Phone<span class="text-coral">*</span></span>
        <div class="mt-1 flex items-center h-[45px] max-h-[45px] rounded-md border border-white/40 bg-white overflow-hidden focus-within:ring-2 focus-within:ring-teal">
          <span class="flex items-center gap-1 h-full px-3 text-[16px] text-ink/70 border-r border-black/10 bg-black/5">🇺🇸 +1</span>
          <input type="tel" name="phone_number" required class="h-full w-full px-3 text-[16px] text-ink focus:outline-none" />
        </div>
      </label>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <label class="block">
        <span class="text-white text-field-label font-medium">Email<span class="text-coral">*</span></span>
        <input type="email" name="email" required class="field mt-1 rounded-md border border-white/40 bg-white text-ink focus:outline-none focus:ring-2 focus:ring-teal" />
      </label>
      <label class="block">
        <span class="text-white text-field-label font-medium">Insurance Carrier<span class="text-coral">*</span></span>
        <select name="insurance_carrier" required class="field mt-1 rounded-md border border-white/40 bg-white text-ink focus:outline-none focus:ring-2 focus:ring-teal">
          <option>Aetna</option>
          <option>Blue Cross Blue Shield</option>
          <option>Cigna</option>
          <option>UnitedHealthcare</option>
          <option>Medica</option>
          <option>UMR</option>
          <option>Surest</option>
          <option>Multiplan</option>
          <option>GEHA</option>
          <option>Other</option>
        </select>
      </label>
    </div>
    <div class="grid grid-cols-1 gap-4">
      <label class="block">
        <span class="text-white text-field-label font-medium">Membership Policy ID<span class="text-coral">*</span></span>
        <input type="text" name="membership_policy_id" required class="field mt-1 rounded-md border border-white/40 bg-white text-ink focus:outline-none focus:ring-2 focus:ring-teal" />
      </label>
    </div>
    <button type="submit" class="btn w-full bg-orange hover:brightness-95 text-navy" data-submit-btn>
      <span data-btn-label>Check Your Coverage</span>
    </button>
    <p class="text-white/80 text-disclaimer text-center" data-form-hint>Your information is private and secure. No pressure to commit.</p>
    <p class="text-white/80 text-disclaimer text-center" data-form-fallback hidden>
      Didn't open your phone? Call us directly at <a href={phoneHref} class="underline font-semibold text-white">(888) 648-2661</a>.
    </p>
  </form>
</div>

<script define:vars={{ ctmEndpoint, ctmKey, nameFieldKey, emailFieldKey, phoneHref }}>
  document.querySelectorAll('[data-insurance-form]').forEach((form) => {
    // This component renders more than once per page (hero + mobile), and
    // each instance ships its own copy of this script, which would
    // otherwise re-bind a submit handler onto every form on the page and
    // double-POST to CTM. Guard so each form only ever gets wired once.
    if (form.dataset.wired) return;
    form.dataset.wired = 'true';

    const submitBtn = form.querySelector('[data-submit-btn]');
    const btnLabel = form.querySelector('[data-btn-label]');
    const hintEl = form.querySelector('[data-form-hint]');
    const fallbackEl = form.querySelector('[data-form-fallback]');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (submitBtn?.hasAttribute('disabled')) return;
      submitBtn?.setAttribute('disabled', '');

      const data = new FormData(form);
      const localPhone = String(data.get('phone_number') || '').replace(/\D/g, '');
      const gclid = new URLSearchParams(window.location.search).get('gclid');

      const params = {
        phone_number: `+1${localPhone}`,
        'custom_fields[insurance_carrier]': String(data.get('insurance_carrier') || ''),
        'custom_fields[membership_policy_id]': String(data.get('membership_policy_id') || ''),
        [`custom_fields[${nameFieldKey}]`]: `FORM: ${String(data.get('caller_name') || '')}`,
        [`custom_fields[${emailFieldKey}]`]: String(data.get('email') || ''),
      };
      if (gclid) params['paid_attribution[gclid]'] = gclid;

      // Fire the CTM post in the background — a tel: handoff doesn't unload
      // the page, so this request keeps running after the redirect below.
      // We don't gate the call on it: a slow or failed CTM post shouldn't
      // stop someone from reaching admissions.
      fetch(`${ctmEndpoint}?key=${ctmKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(params).toString(),
      })
        .then((res) => {
          if (!res.ok) throw new Error(`CTM formreactor responded ${res.status}`);
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'insurance_form_submit', form_location: form.closest('[id]')?.id || 'unknown' });
        })
        .catch((err) => console.error('Insurance form CTM submission failed:', err));

      if (btnLabel) btnLabel.textContent = 'Calling...';
      hintEl?.setAttribute('hidden', '');
      fallbackEl?.removeAttribute('hidden');
      window.location.href = phoneHref;

      // The dialer handoff doesn't navigate away, so restore the button
      // shortly after in case the user cancels the call and stays on page.
      setTimeout(() => {
        submitBtn?.removeAttribute('disabled');
        if (btnLabel) btnLabel.textContent = 'Check Your Coverage';
      }, 4000);
    });
  });
</script>
