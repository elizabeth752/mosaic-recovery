---
const phone = '(888) 648-2661';
const phoneHref = 'tel:8886482661';
---
<header class="sticky top-0 z-50 bg-white py-5 md:py-7 px-6 md:px-[37px] shadow-sm">
  <div class="max-w-[1300px] mx-auto flex items-center justify-between gap-4">
    <a href="/" class="shrink-0">
      <img src="/Asset/Logo/mosaicminds-logo.svg" alt="Mosaic Minds" class="h-8 md:h-11 w-auto" />
    </a>
    <a href={phoneHref} aria-label={`Call ${phone}`} class="btn !flex sm:!hidden !w-[45px] !px-0 !rounded-full bg-orange hover:brightness-95 text-navy shrink-0">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.5 6.5l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
    </a>
    <a
      href={phoneHref}
      class="btn !hidden sm:!inline-flex bg-orange hover:brightness-95 text-navy shrink-0"
    >
      Call Us
      <span class="inline-flex items-center gap-1.5">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.5 6.5l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8z"/></svg>
        {phone}
      </span>
    </a>
  </div>
</header>
