---
const links = [
  { href: '#our-center', text: 'Our Center' },
  { href: '#conditions-we-treat', text: 'Conditions We Treat' },
  { href: '#programs', text: 'Programs' },
];
---
<nav class="bg-white border-b border-black/10 px-6 md:px-[37px]">
  <div class="max-w-[1300px] mx-auto flex items-center justify-center gap-8 md:gap-10 py-4 text-sm md:text-base font-medium">
    {links.map((l, i) => (
      <a href={l.href} class={i === 0 ? 'text-coral border-b-2 border-coral pb-1' : 'text-ink/80 hover:text-coral transition'}>
        {l.text}
      </a>
    ))}
  </div>
</nav>
