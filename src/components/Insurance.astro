---
const logos = [
  { src: '/Asset/Insurance/geha.svg', alt: 'GEHA' },
  { src: '/Asset/Insurance/aetna.svg', alt: 'Aetna' },
  { src: '/Asset/Insurance/bluecross-blueshield.svg', alt: 'Blue Cross Blue Shield' },
  { src: '/Asset/Insurance/cigna.svg', alt: 'Cigna' },
  { src: '/Asset/Insurance/united-healthcare.svg', alt: 'United Healthcare' },
  { src: '/Asset/Insurance/medica.svg', alt: 'Medica' },
  { src: '/Asset/Insurance/umr.svg', alt: 'UMR' },
  { src: '/Asset/Insurance/surest.svg', alt: 'Surest' },
  { src: '/Asset/Insurance/multiplan.svg', alt: 'Multiplan' },
];
---
<section class="bg-white py-10 md:py-[70px] px-6 md:px-[37px]">
  <div class="max-w-[1300px] mx-auto text-center">
    <h2 class="font-display text-[28px] leading-[32px] md:text-[42px] md:leading-[46px] text-navy">In-Network With Most Major Plans</h2>
    <p class="mt-4 max-w-3xl mx-auto text-ink/75">
      We&rsquo;re in-network with most major insurance providers, including Aetna, Blue Cross Blue Shield, Cigna, UnitedHealthcare, Medica, UMR, Surest, Multiplan, and GEHA. Verify your benefits in minutes, with no obligation.
    </p>

    <div class="mt-10 overflow-hidden">
      <div class="insurance-marquee flex items-center gap-[80px] w-max">
        {[...logos, ...logos].map(l => (
          <div class="shrink-0 w-[150px] flex items-center justify-center">
            <img src={l.src} alt={l.alt} class="max-h-10 md:max-h-12 w-auto object-contain" />
          </div>
        ))}
      </div>
    </div>

    <a href="#verify" class="btn mt-10 border border-black/20 hover:bg-black/5 text-ink">
      Request a Confidential VOB
    </a>
  </div>
</section>
